#!/bin/sh
set -e

# Real, dedicated service user -- the systemd unit runs as this, never root.
if ! getent group claudia-mcp >/dev/null; then
  addgroup --system claudia-mcp
fi
if ! getent passwd claudia-mcp >/dev/null; then
  adduser --system --ingroup claudia-mcp --home /nonexistent --no-create-home \
    --shell /usr/sbin/nologin claudia-mcp
fi

# Copy example config into place ONLY if no real config exists yet -- an upgrade must never
# silently overwrite a real admin's real, already-configured deployment.
if [ ! -f /etc/claudia-mcp/config.json ]; then
  cp /etc/claudia-mcp/config.json.example /etc/claudia-mcp/config.json
fi
if [ ! -f /etc/claudia-mcp/tools.json ]; then
  cp /etc/claudia-mcp/tools.json.example /etc/claudia-mcp/tools.json
fi

chown -R root:claudia-mcp /etc/claudia-mcp
chmod 750 /etc/claudia-mcp
chmod 640 /etc/claudia-mcp/config.json /etc/claudia-mcp/tools.json

systemctl daemon-reload || true

echo ""
echo "claudia-mcp-server installed. Before it will run correctly:"
echo "  1. Edit /etc/claudia-mcp/config.json with your real Supabase project details."
echo "  2. Edit /etc/claudia-mcp/tools.json with your real tool definitions."
echo "  3. Start it:  sudo systemctl enable --now claudia-mcp-server"
echo "  4. Check it:  sudo systemctl status claudia-mcp-server"
echo ""

exit 0
